# Sample configuration for the Shopify catalog importer API.
#
# Copy this file to .env at the repository root and edit the copy. The real .env is ignored by
# version control; this sample must stay free of secrets.
#
# Every value below is the built-in default, so copying the file unchanged gives a working
# configuration. An empty value (NAME=) is an error, not "unset": to fall back to a default,
# delete the line or keep it commented out. A variable set in the real environment overrides the
# same name in .env.
#
# The secret key is never stored here. SECRET_KEY_FILE only says where the key file lives.

NODE_ENV=development

# API binds to loopback by default. A non-loopback host also needs ALLOW_NON_LOOPBACK=true and
# the API has no authentication, so only do that on purpose.
API_HOST=127.0.0.1
API_PORT=3000
WEB_HOST=127.0.0.1
WEB_PORT=5173
ALLOW_NON_LOOPBACK=false

# Optional: comma-separated exact origins allowed by CORS and the request guard (no path, no
# wildcard). When absent it is derived from WEB_PORT, as shown.
# ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Pinned Shopify Admin GraphQL API version. Stored only; nothing calls Shopify yet.
SHOPIFY_API_VERSION=2026-10

# Relative paths resolve against the repository root, not the folder you start the process from.
# A leading ~ means your home directory.
DATA_DIR=./data
SECRET_KEY_FILE=~/.shopify-catalog-importer/secret.key

SQLITE_BUSY_TIMEOUT_MS=5000
# One of: error, warn, info, debug
LOG_LEVEL=info
