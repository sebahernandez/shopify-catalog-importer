{
  "name": "shopify-catalog-importer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "pnpm --filter @importer/contracts build",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "pretypecheck": "pnpm --filter @importer/contracts build",
    "typecheck": "pnpm -r typecheck",
    "prelint": "pnpm db:generate",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "pnpm --filter @importer/contracts build",
    "test": "pnpm -r test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "db:generate": "pnpm --filter @importer/api db:generate",
    "db:migrate": "pnpm --filter @importer/api db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
