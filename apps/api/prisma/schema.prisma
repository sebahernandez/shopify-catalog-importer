// The client is generated by `pnpm db:generate` into a folder that is not committed.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The connection URL lives in prisma.config.ts, which takes it from the application's own
// configuration loader. The running API connects through an explicit driver adapter.
datasource db {
  provider = "sqlite"
}

// Small key-value table. S0 uses it for the SecretBox key-check record; nothing else lives here.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("app_setting")
}
